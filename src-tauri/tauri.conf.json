{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLibrary",
  "version": "0.4.4",
  "identifier": "Ezzud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Game Library",
        "width": 1380,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Ezzud",
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNDc0RDc3N0VGMjg0OEEKUldTS2hQSitkMDFIbzRTaEtxdGVEWWNKZlk4MnA2aU16L3ZaZVJWSUI5VmhEL2YrUU4rdEM2OFgK",
      "endpoints": [
        "https://github.com/Ezzud/gamelibrary/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
